ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
PORT=5000

# Required for the instant pay->unlock flow (checks Stripe directly so paying
# customers get full access immediately instead of waiting on a manual email).
# Use your RESTRICTED secret key (read-only on Customers/Subscriptions/Charges),
# not your full secret key. Get one at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your-restricted-key-here

# Random long string used to sign the unlock cookie. Generate your own with:
# python -c "import secrets; print(secrets.token_hex(32))"
UNLOCK_SECRET=change-me-to-a-random-secret

# Free, no-signup tries allowed per visitor per 24h before they're asked to pay.
FREE_TRIAL_LIMIT=3
